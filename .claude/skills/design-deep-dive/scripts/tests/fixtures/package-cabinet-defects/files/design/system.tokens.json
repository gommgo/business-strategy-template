        "600": {
          "$value": {"colorSpace": "srgb", "components": [0.851, 0.4667, 0.0235], "hex": "#d97706"}
        }
      },
      "shadow": {
        "key": {
          "$value": {"colorSpace": "srgb", "components": [0.0078, 0.0235, 0.0902], "alpha": 0.08, "hex": "#020617"}
