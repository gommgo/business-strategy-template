        },
        "950": {
          "$value": {"colorSpace": "srgb", "components": [0.0078, 0.0235, 0.0902], "hex": "#020617"}
        }
      },
      "accent": {
        "50": {
          "$value": {"colorSpace": "srgb", "components": [0.9373, 0.9647, 1.0], "hex": "#eff6ff"}
        },
        "400": {
          "$value": {"colorSpace": "srgb", "components": [0.3765, 0.6471, 0.9804], "hex": "#60a5fa"}
        },
        "600": {
          "$value": {"colorSpace": "srgb", "components": [0.1451, 0.3882, 0.9216], "hex": "#2563eb"}
