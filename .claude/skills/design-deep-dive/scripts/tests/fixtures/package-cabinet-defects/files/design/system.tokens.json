        "600": {
          "$value": {"colorSpace": "srgb", "components": [0.8627, 0.149, 0.149], "hex": "#dc2626"}
        }
      },
      "green": {
        "400": {
          "$value": {"colorSpace": "srgb", "components": [0.2902, 0.8706, 0.502], "hex": "#4ade80"}
        },
        "600": {
          "$value": {"colorSpace": "srgb", "components": [0.0863, 0.6392, 0.2902], "hex": "#16a34a"}
        }
      },
      "amber": {
        "400": {
          "$value": {"colorSpace": "srgb", "components": [0.9843, 0.749, 0.1412], "hex": "#fbbf24"}
