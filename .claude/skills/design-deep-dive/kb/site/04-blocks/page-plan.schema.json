          "$ref": "#/$defs/id"
        },
        "anatomy": {
          "$ref": "#/$defs/anatomy-ref"
        },
        "group": {
          "$ref": "#/$defs/group-instance"
        },
        "required": {
          "type": "boolean"
        },
        "media_role": {
          "enum": [
            "informational",
            "decorative"
          ],
          "description": "= role плана ассетов ai-media."
