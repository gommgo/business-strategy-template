              }
            },
            "media": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media-slot"
              }
            },
            "3d": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/slot-3d"
              }
            },
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/data-slot"
              }
            },
            "action": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/action-slot"
              }
            }
          }
        },
        "treatment": {
          "$ref": "#/$defs/treatment"
        },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
