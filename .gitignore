# Локальные настройки Claude Code (персональные, не для общего репо)
**/.claude/settings.local.json
**/.claude/settings.local.json.*

# Данные заказчика и секреты в репо не хранятся
.env
.env.local
credentials*
*.pem
*.key

# OS / редакторы
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Клоны внешних методологий для ресёрча (не часть шаблона)
.refs/

# Слой дизайна: в git — только принятые ассеты с манифестом. Кадры проверок пересоздаются из HTML-копий;
# файлы Blender, мастер-файлы и исходники генераций лежат у владельца — где, говорит строка манифеста ассета
docs/projects/*/design/*/review/**/*.png
*.blend
*.blend1
